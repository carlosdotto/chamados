@page "{id:guid}"
@model EditarModel
@{
    ViewData["Title"] = $"Editar {Model.Input.Titulo}";
}

<h1>Editar chamado</h1>

<form method="post" class="formulario" novalidate asp-route-id="@Model.Id">
    <div asp-validation-summary="ModelOnly" class="erros"></div>

    <input asp-for="Input.Versao" type="hidden" />

    <partial name="_FormularioChamado" model="Model.Input" />

    <div class="acoes">
        <button type="submit">Salvar alterações</button>
        <a asp-page="./Detalhes" asp-route-id="@Model.Id">Cancelar</a>
    </div>
</form>
